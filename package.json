{
  "name": "stellarboat",
  "version": "0.1.0",
  "description": "A production-ready Astro.js starter for marketing mini-sites and landing pages.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:worker": "wrangler dev --port 8787",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "check": "astro check",
    "check:worker": "tsc -p worker",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:worker": "vitest run -c worker/vitest.config.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "prepare": "husky",
    "postinstall": "astro sync"
  },
  "keywords": [],
  "author": "StellarBoat Contributors",
  "license": "MIT",
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": "eslint --fix",
    "*.{astro,js,mjs,cjs,ts,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@astrojs/rss": "latest",
    "@astrojs/sitemap": "latest",
    "@eslint/js": "latest",
    "@iconify-json/heroicons": "latest",
    "@lhci/cli": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "astro": "latest",
    "astro-icon": "latest",
    "eslint": "latest",
    "eslint-plugin-astro": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.0",
    "prettier": "latest",
    "prettier-plugin-astro": "latest",
    "serve": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8"
  }
}
