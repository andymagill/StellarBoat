# Public variables (prefixed with PUBLIC_ are accessible in the browser)

# Site configuration
PUBLIC_SITE_URL=https://example.com
PUBLIC_SITE_NAME=StellarBoat Demo

# Google Tag Manager ID (optional; null/empty disables GTM)
# Get this from your GTM account dashboard: https://tagmanager.google.com
PUBLIC_GTM_ID=

# Set to 'true' to enable GDPR consent mode v2 in GTM
PUBLIC_CONSENT_MODE=false

# Disable indexing in non-production environments
# Set to 'true' to add 'noindex' to robots.txt and meta tags
PUBLIC_NOINDEX=false

# Demo site toggle - set to 'false' to hide /demo/* routes in production
PUBLIC_DEMO_ENABLED=true

# Cloudflare Turnstile site key (public — safe to expose in the browser).
# Get from: https://dash.cloudflare.com → Turnstile → your site → Site Key
# For local dev without a real Turnstile site, use the "always passes"
# test sitekey: 1x00000000000000000000AA (pair with the matching test
# secret key in .dev.vars — see .dev.vars.example).
PUBLIC_TURNSTILE_SITE_KEY=

# Private variables (only available server-side during build)

# Worker secrets (TURNSTILE_SECRET_KEY, APPS_SCRIPT_URL,
# APPS_SCRIPT_HMAC_SECRET) are NOT set here — they're read by the Worker
# at request time, not at build time. Set them with `wrangler secret put`,
# in the Cloudflare Dashboard, or locally in `.dev.vars` (copy from
# .dev.vars.example). See DEPLOYMENT.md#form-worker.
