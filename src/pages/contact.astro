---
import Page from '../layouts/Page.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import LeadCaptureForm from '../components/forms/LeadCaptureForm.astro';
import Card from '../components/ui/Card.astro';
import CodeBlock from '../components/mdx/CodeBlock.astro';
import Alert from '../components/ui/Alert.astro';

/**
 * Contact page — fork-editable
 *
 * This page shows a single contact form and usage examples for how to
 * customize forms and override the submission endpoint per-instance.
 *
 * Edit the headline, description, and examples below.
 */
---

<Page
  title="Contact"
  description="Get in touch with StellarBoat. We'd love to hear from you."
>
  <div class="max-w-4xl mx-auto px-6 py-12 lg:py-16">
    <!-- Demo Notice -->
    <Alert variant="info" class="mb-8">
      <div>
        <p class="font-semibold mb-2">
          This is a real, working pipeline — submissions land in a demo Google
          Sheet
        </p>
        <p class="text-sm">
          To discuss StellarBoat or report issues, please <a
            href="https://github.com/andymagill/stellarboat/issues"
            class="underline font-semibold hover:opacity-80"
            >create an issue on GitHub</a
          >
        </p>
      </div>
    </Alert>

    <!-- Header -->
    <div class="mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-text mb-4">
        Get in Touch
      </h1>
      <p class="text-lg text-text-muted max-w-2xl mx-auto">
        Have questions about StellarBoat? Fill out the form below to see how the
        contact form component works.
      </p>
    </div>

    <!-- Forms — side-by-side -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      <!-- Contact Form -->
      <div>
        <h2 class="text-xl font-semibold text-text mb-2">Contact Us</h2>
        <p class="text-sm text-text-muted mb-4">
          General enquiries and support requests.
        </p>
        <Card class="p-6">
          <ContactForm />
        </Card>
      </div>

      <!-- Lead Capture Form -->
      <div>
        <h2 class="text-xl font-semibold text-text mb-2">Request a Demo</h2>
        <p class="text-sm text-text-muted mb-4">
          Interested in StellarBoat for your project? Share your details and
          we&rsquo;ll be in touch.
        </p>
        <Card class="p-6">
          <LeadCaptureForm />
        </Card>
      </div>
    </div>

    <!-- Usage Examples Section -->
    <section class="mt-16 pt-12 border-t border-border">
      <h2 class="text-2xl font-bold text-text mb-6">Form Usage Examples</h2>
      <p class="text-text-muted mb-8">
        All StellarBoat forms POST to the same Worker endpoint by default, which
        gates submissions and forwards them to a Google Sheet. Here are common
        patterns you can use in your fork:
      </p>

      <!-- Example 1: ContactForm with global endpoint -->
      <div class="mb-10">
        <h3 class="text-lg font-semibold text-text mb-3">
          1. Contact Form (global endpoint)
        </h3>
        <p class="text-text-muted mb-4">
          Uses the default endpoint from <code class="bg-surface-2 px-1 rounded"
            >src/config/forms.ts</code
          >:
        </p>
        <CodeBlock lang="astro"> &lt;ContactForm /&gt; </CodeBlock>
      </div>

      <!-- Example 2: LeadCaptureForm with endpoint override -->
      <div class="mb-10">
        <h3 class="text-lg font-semibold text-text mb-3">
          2. Lead Capture Form (endpoint override)
        </h3>
        <p class="text-text-muted mb-4">
          Override the endpoint per-form to route to a different Worker
          deployment (e.g. a staging environment):
        </p>
        <CodeBlock lang="astro">
          &lt;LeadCaptureForm endpoint="https://staging.example.com/api/forms"
          /&gt;
        </CodeBlock>
      </div>

      <!-- Example 3: NewsletterForm compact layout -->
      <div class="mb-10">
        <h3 class="text-lg font-semibold text-text mb-3">
          3. Newsletter Form (compact layout)
        </h3>
        <p class="text-text-muted mb-4">
          A single-field, inline-friendly layout for footers and sidebars:
        </p>
        <CodeBlock lang="astro"> &lt;NewsletterForm compact /&gt; </CodeBlock>
      </div>

      <!-- See the forms page -->
      <div class="pt-6 border-t border-border">
        <p class="text-text-muted">
          For more details, see the <a
            href="/forms"
            class="text-primary-500 hover:text-primary-600 font-semibold"
          >
            Forms Components page
          </a> — it demonstrates all three form variants and how the submission pipeline
          works.
        </p>
      </div>
    </section>

    <!-- Get involved -->
    <section class="mt-16 pt-12 border-t border-border text-center">
      <h3 class="text-xl font-semibold text-text mb-4">
        Get involved with StellarBoat
      </h3>
      <p class="text-text-muted mb-6 max-w-2xl mx-auto">
        StellarBoat is open source. Have ideas, feature requests, or found a
        bug? Visit the project on GitHub:
      </p>
      <div>
        <a
          href="https://github.com/andymagill/stellarboat"
          class="inline-block text-primary-500 hover:text-primary-600 font-semibold text-lg"
        >
          github.com/andymagill/stellarboat
        </a>
      </div>
    </section>
  </div>
</Page>
