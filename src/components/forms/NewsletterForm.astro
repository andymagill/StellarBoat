---
/**
 * Newsletter signup form component.
 *
 * A single-field email form for newsletter/list signup with:
 * - Compact, inline-friendly layout
 * - Same progressive enhancement, spam gating, and validation as ContactForm
 *
 * @example
 * ```astro
 * <!-- Uses the global endpoint from src/config/forms.ts -->
 * <NewsletterForm />
 *
 * <!-- Compact inline layout (e.g. footer) -->
 * <NewsletterForm compact />
 * ```
 */

import { forms } from '../../config/forms';
import FormField from './FormField.astro';
import Button from '../ui/Button.astro';

export interface Props {
  endpoint?: string;
  turnstileSiteKey?: string;
  idPrefix?: string;
  class?: string;
  /** Show a compact, inline-friendly layout (for footer usage) */
  compact?: boolean;
}

const {
  endpoint = forms.endpoint,
  turnstileSiteKey = forms.turnstileSiteKey,
  idPrefix = 'newsletter',
  class: className = '',
  compact = false,
} = Astro.props;
---

<form
  method="POST"
  action={endpoint}
  data-stellar-form="newsletter"
  data-id-prefix={idPrefix}
  data-turnstile-sitekey={turnstileSiteKey}
  class={`${compact ? 'flex gap-2' : 'space-y-4'} ${className}`}
>
  <input type="hidden" name="formType" value="newsletter" />

  {/* Honeypot — hidden from sighted and keyboard users, bots fill it in */}
  <div class="absolute -left-[9999px]" aria-hidden="true">
    <label for={`${idPrefix}-website`}>Website</label>
    <input
      type="text"
      id={`${idPrefix}-website`}
      name="website"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  {
    !compact ? (
      <FormField
        id={`${idPrefix}-email`}
        name="email"
        label="Email Address"
        type="email"
        required
        placeholder="you@example.com"
        autocomplete="email"
      />
    ) : (
      <input
        type="email"
        id={`${idPrefix}-email`}
        name="email"
        required
        placeholder="your@email.com"
        class="flex-1 px-4 py-2.5 bg-neutral-800 border border-neutral-700 text-white rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-400"
      />
    )
  }

  <div data-turnstile></div>

  <noscript>
    <p class="text-sm text-error">
      JavaScript is required to submit this form (for spam verification).
    </p>
  </noscript>

  <div data-form-messages class="hidden"></div>

  <Button type="submit" variant="primary" size={compact ? 'md' : 'md'}>
    {compact ? 'Subscribe' : 'Join'}
  </Button>
</form>

<script>
  import { enhanceForms } from '../../utils/forms/client';
  enhanceForms();
</script>
