---
/**
 * Lead capture form component.
 *
 * A four-field lead generation form (name, email, company, phone) with:
 * - Required fields: name, email
 * - Optional fields: company, phone
 * - Same progressive enhancement, spam gating, and validation as ContactForm
 *
 * @example
 * ```astro
 * <!-- Uses the global endpoint from src/config/forms.ts -->
 * <LeadCaptureForm />
 *
 * <!-- Override to a different Worker deployment -->
 * <LeadCaptureForm endpoint="https://forms.example.com/api/forms" />
 * ```
 */

import { forms } from '../../config/forms';
import FormField from './FormField.astro';
import Button from '../ui/Button.astro';

export interface Props {
  endpoint?: string;
  turnstileSiteKey?: string;
  idPrefix?: string;
  class?: string;
}

const {
  endpoint = forms.endpoint,
  turnstileSiteKey = forms.turnstileSiteKey,
  idPrefix = 'lead',
  class: className = '',
} = Astro.props;
---

<form
  method="POST"
  action={endpoint}
  data-stellar-form="lead"
  data-id-prefix={idPrefix}
  data-turnstile-sitekey={turnstileSiteKey}
  class={`space-y-6 ${className}`}
>
  <input type="hidden" name="formType" value="lead" />

  {/* Honeypot — hidden from sighted and keyboard users, bots fill it in */}
  <div class="absolute -left-[9999px]" aria-hidden="true">
    <label for={`${idPrefix}-website`}>Website</label>
    <input
      type="text"
      id={`${idPrefix}-website`}
      name="website"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <FormField
    id={`${idPrefix}-name`}
    name="name"
    label="Full Name"
    type="text"
    required
    placeholder="John Doe"
  />

  <FormField
    id={`${idPrefix}-email`}
    name="email"
    label="Email Address"
    type="email"
    required
    placeholder="you@company.com"
    autocomplete="email"
  />

  <FormField
    id={`${idPrefix}-company`}
    name="company"
    label="Company"
    type="text"
    placeholder="Your Company"
    autocomplete="organization"
  />

  <FormField
    id={`${idPrefix}-phone`}
    name="phone"
    label="Phone"
    type="tel"
    placeholder="+1 (555) 000-0000"
    autocomplete="tel"
  />

  <div data-turnstile></div>

  <noscript>
    <p class="text-sm text-error">
      JavaScript is required to submit this form (for spam verification).
    </p>
  </noscript>

  <div data-form-messages class="hidden"></div>

  <Button type="submit" variant="primary" size="md">Get Started</Button>
</form>

<script>
  import { enhanceForms } from '../../utils/forms/client';
  enhanceForms();
</script>
