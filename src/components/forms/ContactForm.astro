---
/**
 * Contact form component.
 *
 * A three-field contact form (name, email, message) with:
 * - Native HTML5 form that works without JavaScript (posts to the same
 *   Worker endpoint, which redirects to a friendly "enable JavaScript"
 *   page — Turnstile verification requires a browser to run)
 * - Progressive enhancement: JSON/AJAX submission when JS is available
 * - Loading, success, and error states with accessible messaging
 * - Cloudflare Turnstile spam gate, honeypot field, and shared validation
 *
 * @example
 * ```astro
 * <!-- Uses the global endpoint from src/config/forms.ts -->
 * <ContactForm />
 *
 * <!-- Override to a different Worker deployment -->
 * <ContactForm endpoint="https://forms.example.com/api/forms" />
 * ```
 */

import { forms } from '../../config/forms';
import FormField from './FormField.astro';
import Button from '../ui/Button.astro';

export interface Props {
  /** Submission endpoint override */
  endpoint?: string;

  /** Turnstile site key override */
  turnstileSiteKey?: string;

  /** Prefix for field ids, to avoid collisions with other forms on the page */
  idPrefix?: string;

  /** Additional CSS classes */
  class?: string;
}

const {
  endpoint = forms.endpoint,
  turnstileSiteKey = forms.turnstileSiteKey,
  idPrefix = 'contact',
  class: className = '',
} = Astro.props;
---

<form
  method="POST"
  action={endpoint}
  data-stellar-form="contact"
  data-id-prefix={idPrefix}
  data-turnstile-sitekey={turnstileSiteKey}
  class={`space-y-6 ${className}`}
>
  <input type="hidden" name="formType" value="contact" />

  {/* Honeypot — hidden from sighted and keyboard users, bots fill it in */}
  <div class="absolute -left-[9999px]" aria-hidden="true">
    <label for={`${idPrefix}-website`}>Website</label>
    <input
      type="text"
      id={`${idPrefix}-website`}
      name="website"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <FormField
    id={`${idPrefix}-name`}
    name="name"
    label="Name"
    type="text"
    required
    placeholder="Your name"
  />

  <FormField
    id={`${idPrefix}-email`}
    name="email"
    label="Email"
    type="email"
    required
    placeholder="you@example.com"
    autocomplete="email"
  />

  <FormField
    id={`${idPrefix}-message`}
    name="message"
    label="Message"
    type="textarea"
    required
    placeholder="Your message here..."
  />

  {
    /* Cloudflare Turnstile renders here once the visitor interacts with the form */
  }
  <div data-turnstile></div>

  <noscript>
    <p class="text-sm text-error">
      JavaScript is required to submit this form (for spam verification).
    </p>
  </noscript>

  {/* Success/error alerts (hidden by default) */}
  <div data-form-messages class="hidden"></div>

  <Button type="submit" variant="primary" size="md">Send Message</Button>
</form>

<script>
  import { enhanceForms } from '../../utils/forms/client';
  enhanceForms();
</script>
